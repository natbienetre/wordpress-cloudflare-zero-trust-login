{
    "name": "natbienetre/wp-cloudflare-zero-trust-login",
    "type": "wordpress-plugin",
    "description": "WordPress plugin to setup Cloudflare zero trust authentication",
    "license": "MPL-2.0",
    "autoload": {
        "psr-4": {
            "Natbienetre\\WpCloudflareZeroTrustLogin\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Pierre PÉRONNET",
            "email": "pierre.peronnet@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "firebase/php-jwt": "^7.1",
        "composer/installers": "^2.3"
    },
    "require-dev": {
        "wp-cli/wp-cli-bundle": "^2.12",
        "phpunit/phpunit": "^9.6.33",
        "yoast/phpunit-polyfills": "^4"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "platform": {
            "php": "8.3.33"
        }
    }
}
